<?xml version="1.0" encoding="utf-8"?>
<!-- 가로 모드: 왼쪽에 입력·버튼, 오른쪽에 결과를 배치해 한 화면에 모두 보이게 함 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사칙연산 계산기"
                android:textColor="#1B2A41"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="FourBasicOpt · add / subtract / multiply / divide"
                android:textColor="#6B7A90"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editX"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="첫 번째 숫자 (x)"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="numberSigned|numberDecimal"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/editY"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="두 번째 숫자 (y)"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="numberSigned|numberDecimal"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAdd"
                    style="@style/OpButton"
                    android:layout_height="52dp"
                    android:text="+" />

                <Button
                    android:id="@+id/btnSubtract"
                    style="@style/OpButton"
                    android:layout_height="52dp"
                    android:text="−" />

                <Button
                    android:id="@+id/btnMultiply"
                    style="@style/OpButton"
                    android:layout_height="52dp"
                    android:text="×" />

                <Button
                    android:id="@+id/btnDivide"
                    style="@style/OpButton"
                    android:layout_height="52dp"
                    android:text="÷" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#6B7A90"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="#1B2A41"
                android:textSize="44sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
