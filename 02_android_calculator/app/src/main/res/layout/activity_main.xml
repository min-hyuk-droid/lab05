<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="사칙연산 계산기"
            android:textColor="#1B2A41"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="FourBasicOpt · add / subtract / multiply / divide"
            android:textColor="#6B7A90"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="첫 번째 숫자 (x)"
            android:imeOptions="flagNoExtractUi"
        android:inputType="numberSigned|numberDecimal"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/editY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="두 번째 숫자 (y)"
            android:imeOptions="flagNoExtractUi"
        android:inputType="numberSigned|numberDecimal"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdd"
                style="@style/OpButton"
                android:text="+" />

            <Button
                android:id="@+id/btnSubtract"
                style="@style/OpButton"
                android:text="−" />

            <Button
                android:id="@+id/btnMultiply"
                style="@style/OpButton"
                android:text="×" />

            <Button
                android:id="@+id/btnDivide"
                style="@style/OpButton"
                android:text="÷" />
        </LinearLayout>

        <TextView
            android:id="@+id/textExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="end"
            android:textColor="#6B7A90"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="#1B2A41"
            android:textSize="48sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
